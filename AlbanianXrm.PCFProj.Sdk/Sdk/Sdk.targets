<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<ItemGroup>
		<PackageReference Include="Microsoft.PowerApps.MSBuild.Pcf" >
			<Version Condition="'$(ManagePackageVersionsCentrally)'!='true'">2.11.1</Version>
		</PackageReference>
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="All">
			<Version Condition="'$(ManagePackageVersionsCentrally)'!='true'">1.0.3</Version>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ExcludeDirectories Include="~/**" />
		<ExcludeDirectories Include=".gitignore" />
		<ExcludeDirectories Include=".vs/**" />
		<ExcludeDirectories Include="bin/**" />
		<ExcludeDirectories Include="node_modules/**" />
		<ExcludeDirectories Include="obj/**" />
		<ExcludeDirectories Include="$(OutputPath)/**" />
		<ExcludeDirectories Include="*.pcfproj" />
		<ExcludeDirectories Include="*.pcfproj.user" />
		<ExcludeDirectories Include="*.sln" />
		<ExcludeDirectories Include="*.slnx" />
	</ItemGroup>

	<ItemGroup>
		<PCFProjectManifestFile Include="**/ControlManifest.Input.xml" Exclude="@(ExcludeDirectories)" />
		<UpToDateCheckOutput Include="@(PCFProjectManifestFile->'$(OutputPath)%(RelativeDir)bundle.js')" />
		<UpToDateCheckOutput Include="@(PCFProjectManifestFile->'$(OutputPath)%(RelativeDir)ControlManifest.xml')" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="**" Exclude="@(ExcludeDirectories);**/generated/*.ts" CopyToOutputDirectory="Never" />
		<None Remove="@(ExcludeDirectories)" />
		<Content Remove="@(ExcludeDirectories)" />
		<None Include="**/generated/*.ts" Exclude="@(ExcludeDirectories)" />
	</ItemGroup>

	<Import 
		Project="$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Pcf.targets" 
		Condition="Exists('$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Pcf.targets')" 
	/>



	<Import Project="./Shared.targets/NoAssembly.targets" />

	<Target BeforeTargets="_InitPcfAutoNpmInstall" Name="FixIssueWithNPMWorkspaces">
		<ItemGroup>
			<_PcfScriptsPackageFile Remove="@(_PcfScriptsPackageFile)" />
		</ItemGroup>
	</Target>

	<Target
		Name="_SetFileVersionFromGitVersioning"
		Condition="'$(FileVersion)' == '' AND '$(EnableGitVersioning)' == 'true'"
		BeforeTargets="_SetFileVersionOnSolution"
	>
		<MSBuild
			Projects="$(MSBuildProjectFullPath)"
			Targets="GetBuildVersion"
			Properties="EnableGitVersioning=$(EnableGitVersioning);Configuration=$(Configuration);Restore=false"
			ContinueOnError="WarnAndContinue"
		>
			<Output TaskParameter="TargetOutputs" ItemName="_GitBuildVersionItem" />
		</MSBuild>
		<PropertyGroup Condition="'@(_GitBuildVersionItem)' != ''">
			<FileVersion>@(_GitBuildVersionItem)</FileVersion>
		</PropertyGroup>
		<XmlPeek
			XmlInputPath="@(_ControlManifestFile)"
			Query="manifest/control/@version"
		>
			<Output TaskParameter="Result" PropertyName="_CurrentVersion" />
		</XmlPeek>
		<XmlPoke
		    Condition="'@(_GitBuildVersionItem)' != '' AND '$(_CurrentVersion)' != '$(FileVersion)'"
			XmlInputPath="@(_ControlManifestFile)"
			Query="manifest/control/@version"
			Value="$(FileVersion)"
		/>
		<Message Text="Set FileVersion from Nerdbank.GitVersioning to $(FileVersion)" Condition="'@(_GitBuildVersionItem)' != ''" Importance="high" />
		<Warning Text="EnableGitVersioning is true but Git build version is empty. Falling back to Solution.xml version." Condition="'@(_GitBuildVersionItem)' == ''" />
	</Target>

	<Target
		Name="_SetFileVersionOnSolution"
		Condition="'$(FileVersion)' != ''"
		BeforeTargets="Build"
	>
		<XmlPeek
			XmlInputPath="@(_ControlManifestFile)"
			Query="manifest/control/@version"
		>
			<Output TaskParameter="Result" PropertyName="_CurrentVersion" />
		</XmlPeek>

		<XmlPoke
			XmlInputPath="@(_ControlManifestFile)"
			Condition="'$(_CurrentVersion)' != '$(FileVersion)'"
			Query="manifest/control/@version"
			Value="$(FileVersion)"
		/>
		<Message Text="Set Solution version to $(FileVersion)" Importance="high" />
	</Target>
</Project>