<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<AppendTargetFrameworkToOutputPath Condition="'$(AppendTargetFrameworkToOutputPath)' == ''">false</AppendTargetFrameworkToOutputPath>
		<TargetFrameworkVersion Condition="'$(TargetFrameworkVersion)' == ''">v4.6.2</TargetFrameworkVersion>
		<!--Remove TargetFramework when this is available in 16.1-->
		<TargetFramework Condition="'$(TargetFramework)' == ''">net462</TargetFramework>
		<SolutionRootPath Condition="'$(SolutionRootPath)' == ''">src</SolutionRootPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.PowerApps.MSBuild.Solution" >
			<Version Condition="'$(ManagePackageVersionsCentrally)'!='true'">2.*</Version>
		</PackageReference>
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="All">
			<Version Condition="'$(ManagePackageVersionsCentrally)'!='true'">1.0.3</Version>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ExcludeDirectories Include=".vs\**" />
		<ExcludeDirectories Include=".gitignore" />
		<ExcludeDirectories Include="bin\**" />
		<ExcludeDirectories Include="obj\**" />
		<ExcludeDirectories Include="*.cdsproj" />
		<ExcludeDirectories Include="*.cdsproj.user" />
		<ExcludeDirectories Include="*.sln" />
		<ExcludeDirectories Include="*.slnx" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="./**" Exclude="@(ExcludeDirectories)" CopyToOutputDirectory="Never" />
		<None Remove="@(ExcludeDirectories)" />
		<Resource Update="$(SolutionRootPath)/**" Condition="'$(DataverseSolutionLinkPath)' != ''">
			<Link>$(DataverseSolutionLinkPath)/%(RecursiveDir)/%(FileName)%(Extension)</Link>
		</Resource>
		<Resource Remove="@(ExcludeDirectories)" />
		<Content Remove="@(ExcludeDirectories)" />
	</ItemGroup>

	<ItemGroup>
		<!-- TODO: Include="Map File mappings" as Linked Resources so that these participate in AccelerateBuildsInVisualStudio -->
		<UpToDateCheckOutput Include="$(SolutionPackageZipFilePath)" />
	</ItemGroup>

	<Import Project="./Shared/NoAssembly.targets" />

	<Target Name="CopyPluginPackages"
			Outputs="%(DataversePluginPackage.Identity)"
			BeforeTargets="CopyCdsSolutionContent"
	>
		<PropertyGroup>
			<_PluginPackageName Condition="$([System.String]::new('%(DataversePluginPackage.DataversePluginPackageId)').StartsWith('$(PublisherPrefix)_'))">%(DataversePluginPackage.DataversePluginPackageId)</_PluginPackageName>
			<_PluginPackageName Condition="!$([System.String]::new('%(DataversePluginPackage.DataversePluginPackageId)').StartsWith('$(PublisherPrefix)_'))">$(PublisherPrefix)_%(DataversePluginPackage.DataversePluginPackageId)</_PluginPackageName>

			<_ManagedIdentityId Condition="'%(DataversePluginPackage.ManagedIdentityId)'!=''">%(DataversePluginPackage.ManagedIdentityId)</_ManagedIdentityId>
			<_ManagedIdentityIdXml Condition="'%(DataversePluginPackage.ManagedIdentityId)'!=''">
  &lt;managedidentityid&gt;
    &lt;managedidentityid&gt;%(DataversePluginPackage.ManagedIdentityId)&lt;/managedidentityid&gt;
  &lt;/managedidentityid&gt;</_ManagedIdentityIdXml>
			<_ManagedIdentityIdXml Condition="'%(DataversePluginPackage.ManagedIdentityId)'==''"></_ManagedIdentityIdXml>

			<_PluginPackageXml>&lt;pluginpackage uniquename=&quot;$(_PluginPackageName)&quot;&gt;
  &lt;exportkeyversion&gt;1&lt;/exportkeyversion&gt;
  &lt;iscustomizable&gt;1&lt;/iscustomizable&gt;$(_ManagedIdentityIdXml)
  &lt;name&gt;$(_PluginPackageName)&lt;/name&gt;
  &lt;package mimetype=&quot;application/octet-stream&quot;&gt;$(_PluginPackageName).nupkg&lt;/package&gt;
  &lt;statecode&gt;0&lt;/statecode&gt;
  &lt;statuscode&gt;1&lt;/statuscode&gt;
  &lt;version&gt;$(FileVersion)&lt;/version&gt;
&lt;/pluginpackage&gt;</_PluginPackageXml>
		</PropertyGroup>

		<Message Text="Copying $(_PluginPackageName): %(DataversePluginPackage.DataversePluginPackageOutput)" Importance="high" />

		<Copy SourceFiles="%(DataversePluginPackage.DataversePluginPackageOutput)"
			DestinationFiles="$(SolutionRootPath)\pluginpackages\$(_PluginPackageName)\package\$(_PluginPackageName).nupkg"
			Condition="'%(DataversePluginPackage.DataversePluginPackageId)'!=''"
			OverwriteReadOnlyFiles="true" />

		<XmlPeek 
			
			XmlInputPath="$(SolutionRootPath)\pluginpackages\$(_PluginPackageName)\pluginpackage.xml"
			Query="/pluginpackage/version/text()"
			Condition="'%(DataversePluginPackage.DataversePluginPackageId)'!='' AND Exists('$(SolutionRootPath)\pluginpackages\$(_PluginPackageName)\pluginpackage.xml')"
		>
			<Output TaskParameter="Result" ItemName="ExistingPluginPackageVersion" />
		</XmlPeek>

		<XmlPeek 
			
			XmlInputPath="$(SolutionRootPath)\pluginpackages\$(_PluginPackageName)\pluginpackage.xml"
			Query="/pluginpackage/managedidentityid/managedidentityid/text()"
			Condition="'%(DataversePluginPackage.DataversePluginPackageId)'!='' AND Exists('$(SolutionRootPath)\pluginpackages\$(_PluginPackageName)\pluginpackage.xml')"
		>
			<Output TaskParameter="Result" ItemName="ExistingManagedIdentityId" />
		</XmlPeek>

		<WriteLinesToFile
			File="$(SolutionRootPath)\pluginpackages\$(_PluginPackageName)\pluginpackage.xml"
			Overwrite="true"
			Condition="'%(DataversePluginPackage.DataversePluginPackageId)'!='' AND !Exists('$(SolutionRootPath)\pluginpackages\$(_PluginPackageName)\pluginpackage.xml')"
			Lines="$(_PluginPackageXml)" />

		<XmlPoke
			XmlInputPath="$(SolutionRootPath)\pluginpackages\$(_PluginPackageName)\pluginpackage.xml"
			Query="/pluginpackage/version"
			Value="$(FileVersion)"
			Condition="'%(DataversePluginPackage.DataversePluginPackageId)'!='' AND Exists('$(SolutionRootPath)\pluginpackages\$(_PluginPackageName)\pluginpackage.xml') AND '@(ExistingPluginPackageVersion)' != '$(FileVersion)'" />

		<XmlPoke
			XmlInputPath="$(SolutionRootPath)\pluginpackages\$(_PluginPackageName)\pluginpackage.xml"
			Query="/pluginpackage/managedidentityid"
			Value="&lt;managedidentityid&gt;%(DataversePluginPackage.ManagedIdentityId)&lt;/managedidentityid&gt;"
			Condition="'%(DataversePluginPackage.DataversePluginPackageId)'!='' AND Exists('$(SolutionRootPath)\pluginpackages\$(_PluginPackageName)\pluginpackage.xml') AND '@(ExistingManagedIdentityId)' != '$(_ManagedIdentityId)'" />
	</Target>

	<Target
		Name="_CalculateDataversePluginsPath"
		Outputs="%(DataversePluginPackage.Identity)"
		BeforeTargets="CopyPluginPackages"
	>
		<MSBuild Projects="%(DataversePluginPackage.Identity)"
				 Targets="_GetOutputItemsFromPack"
				 Properties="Configuration=$(Configuration);FileVersion=$(FileVersion);PackageReferenceCompatibleProjectStyle=true"
		>
			<Output TaskParameter="TargetOutputs" ItemName="DataversePluginPackageOutput" />
		</MSBuild>
		<Message Text="DataversePluginPackageOutput: @(DataversePluginPackageOutput) Project: %(DataversePluginPackage.Identity)" Importance="high"/>
		<ItemGroup>
			<DataversePluginPackage Update="%(DataversePluginPackage.Identity)" Condition="$([System.String]::new(%(DataversePluginPackageOutput.Identity)).EndsWith('nupkg'))">
				<DataversePluginPackageOutput>%(DataversePluginPackageOutput.Identity)</DataversePluginPackageOutput>
			</DataversePluginPackage>
		</ItemGroup>
	</Target>

	<Target
		Name="PackPlugins"
		BeforeTargets="CopyPluginPackages"
	>
		<!-- Pack the linked project -->
		<MSBuild
			Projects="%(DataversePluginPackage.Identity)"
			Targets="Pack"
			Properties="Configuration=$(Configuration);FileVersion=$(FileVersion)"
		/>
	</Target>

	<Target
		Name="BuildPlugins"
		BeforeTargets="PackPlugins"
	>
		<!-- Build the linked project -->
		<MSBuild
			Projects="%(DataversePluginPackage.Identity)"
			Targets="Build"
			Properties="Configuration=$(Configuration);FileVersion=$(FileVersion)"
		/>
	</Target>

	<Target
		Name="CleanPlugins"
		BeforeTargets="Clean"
	>
		<!-- Clean the linked project -->
		<MSBuild
			Projects="%(DataversePluginPackage.Identity)"
			Targets="Clean"
			Properties="Configuration=$(Configuration);FileVersion=$(FileVersion)"
		/>
	</Target>

	<Target
		Name="RestorePlugins"
		BeforeTargets="Restore"
	>
		<!-- Restore the linked project -->
		<MSBuild
			Projects="%(DataversePluginPackage.Identity)"
			Targets="Restore"
			Properties="Configuration=$(Configuration);FileVersion=$(FileVersion)"
		/>
	</Target>

	<Target
		Name="_CalculateDataversePluginsManagedIdentityId"
		Outputs="%(DataversePluginPackage.Identity)"
		BeforeTargets="_CalculateDataversePluginsPath;CleanPlugins;RestorePlugins;PackPlugins;ProcessCdsProjectReferencesOutputs"
	>
		<XmlPeek
			XmlInputPath="%(DataversePluginPackage.Identity)"
			Query="Project/PropertyGroup/ManagedIdentityId/text()"
			Condition="'%(DataversePluginPackage.Identity)'!=''"
		>
			<Output TaskParameter="Result" ItemName="DataverseManagedIdentityId" />
		</XmlPeek>
		<ItemGroup>
			<DataversePluginPackage Update="%(DataversePluginPackage.Identity)" Condition="'@(DataverseManagedIdentityId)' != ''">
				<ManagedIdentityId>@(DataverseManagedIdentityId)</ManagedIdentityId>
			</DataversePluginPackage>
		</ItemGroup>
	</Target>

	<Target
		Name="_CalculateDataversePluginsPackageId"
		Outputs="%(ProjectReference.Identity)"
		BeforeTargets="_CalculateDataversePluginsManagedIdentityId;_CalculateDataversePluginsPath;CleanPlugins;RestorePlugins;PackPlugins;ProcessCdsProjectReferencesOutputs"
	>
		<XmlPeek
			XmlInputPath="%(ProjectReference.Identity)"
			Query="Project/PropertyGroup/PackageId/text()"
			Condition="'%(ProjectReference.Identity)'!=''"
		>
			<Output TaskParameter="Result" ItemName="DataversePluginPackageId" />
		</XmlPeek>
		<Message Text="ProjectReference: %(ProjectReference.Identity) PackageId: @(DataversePluginPackageId)"  Condition="'@(DataversePluginPackageId)' != ''" Importance="High" />
		<ItemGroup>
			<DataversePluginPackage Include="%(ProjectReference.Identity)"  Condition="'@(DataversePluginPackageId)' != ''">
				<DataversePluginPackageId>@(DataversePluginPackageId)</DataversePluginPackageId>
				<ManagedIdentityId>%(ProjectReference.ManagedIdentityId)</ManagedIdentityId>
			</DataversePluginPackage>
			<ProjectReference Remove="%(ProjectReference.Identity)"  Condition="'@(DataversePluginPackageId)' != ''" />
		</ItemGroup>
	</Target>

	<Target
		Name="_SetFileVersionFromGitVersioning"
		Condition="'$(FileVersion)' == '' AND '$(EnableGitVersioning)' == 'true'"
		BeforeTargets="_SetFileVersion"
	>
		<MSBuild
			Projects="$(MSBuildProjectFullPath)"
			Targets="GetBuildVersion"
			Properties="EnableGitVersioning=$(EnableGitVersioning);Configuration=$(Configuration);Restore=false"
			ContinueOnError="WarnAndContinue"
		>
			<Output TaskParameter="TargetOutputs" ItemName="_GitBuildVersionItem" />
		</MSBuild>
		<PropertyGroup Condition="'@(_GitBuildVersionItem)' != ''">
			<FileVersion>@(_GitBuildVersionItem)</FileVersion>
		</PropertyGroup>
		<Message Text="Set FileVersion from Nerdbank.GitVersioning to $(FileVersion)" Condition="'@(_GitBuildVersionItem)' != ''" Importance="high" />
		<Warning Text="EnableGitVersioning is true but Git build version is empty. Falling back to Solution.xml version." Condition="'@(_GitBuildVersionItem)' == ''" />
	</Target>

	<Target
		Name="_SetFileVersion"
		Condition="'$(EnableGitVersioning)' != 'true' OR '$(NerdbankGitVersioningTasksPath)' != ''"
		DependsOnTargets="_SetFileVersionFromGitVersioning"
		BeforeTargets="Build;PackPlugins;CopyPluginPackages"
	>
		<XmlPeek
			XmlInputPath="$(SolutionRootPath)\Other\Solution.xml"
			Query="ImportExportXml/SolutionManifest/Version/text()"
			Condition="'$(FileVersion)' == ''"
		>
			<Output TaskParameter="Result" ItemName="SolutionVersion" />
		</XmlPeek>
		<Message Text="Solution version @(SolutionVersion)" Condition="'$(FileVersion)' == ''" Importance="high" />
		<PropertyGroup Condition="'$(FileVersion)' == ''">
			<FileVersion>@(SolutionVersion)</FileVersion>
			<_ReadFileVersionFromSolution>true</_ReadFileVersionFromSolution>
		</PropertyGroup>
	</Target>

	<Target
		Name="_SetFileVersionOnSolution"
		Condition="'$(FileVersion)' != '' AND '$(_ReadFileVersionFromSolution)' != 'true'"
		BeforeTargets="Build;PackPlugins;CopyPluginPackages"
	>
		<XmlPeek
			XmlInputPath="$(SolutionRootPath)\Other\Solution.xml"
			Query="ImportExportXml/SolutionManifest/Version/text()"
		>
			<Output TaskParameter="Result" ItemName="CurrentSolutionVersion" />
		</XmlPeek>

		<XmlPoke
			XmlInputPath="$(SolutionRootPath)\Other\Solution.xml"
			Condition="'@(CurrentSolutionVersion)' != '$(FileVersion)'"
			Query="ImportExportXml/SolutionManifest/Version"
			Value="$(FileVersion)"
		/>
		<Message Text="Set Solution version to $(FileVersion)" Importance="high" />
	</Target>

	<Target
		Name="_SetPublisherPrefix"
		Condition="'$(PublisherPrefix)' == ''"
		BeforeTargets="CopyPluginPackages"
	>
		<XmlPeek
			XmlInputPath="$(SolutionRootPath)\Other\Solution.xml"
			Query="ImportExportXml/SolutionManifest/Publisher/CustomizationPrefix/text()"
		>
			<Output
				TaskParameter="Result"
				ItemName="PublisherPrefix"
			/>
		</XmlPeek>
		<Message
			Text="Publisher Prefix '@(PublisherPrefix)' read from $(SolutionRootPath)\Other\Solution.xml"
			Importance="high"
		/>
		<PropertyGroup>
			<PublisherPrefix>@(PublisherPrefix)</PublisherPrefix>
		</PropertyGroup>
	</Target>
</Project>